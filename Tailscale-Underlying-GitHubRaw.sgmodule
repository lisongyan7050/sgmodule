#!name=Tailscale 底层自动切换（GitHub Raw）
#!desc=与 Tailscale-Underlying-Remote.sgmodule 相同，但脚本路径改为 GitHub 官方 Raw（tag v3.6，内容固定、无第三方 CDN 缓存、更新即时）。仅在你的设备能直连 raw.githubusercontent.com 时使用；若该域名不通，请改装 Tailscale-Underlying-Remote.sgmodule（jsDelivr）。备用 jsDelivr 域名：fastly.jsdelivr.net / gcore.jsdelivr.net，路径与 @v3.6 段完全相同。
#!system=ios
#!arguments="GROUP:内网底层,DIRECT_SSID:CU_9CGP_5G,CELLULAR_SSID:-,DEBOUNCE_MS:3000,NOTIFY_NOOP:false"
#!arguments-desc="GROUP: 要切换的策略组名。该组必须已存在，且手动选项里同时含有 CELLULAR-ONLY 与 DIRECT\nDIRECT_SSID: 命中的 Wi-Fi 一律走直连，多个用 | 分隔；填 - 表示不启用\nCELLULAR_SSID: 命中的 Wi-Fi 一律走蜂窝，适合公司、校园等屏蔽 UDP 打洞的网络，多个用 | 分隔；填 - 表示不启用\nDEBOUNCE_MS: 防抖窗口，单位毫秒\nNOTIFY_NOOP: 策略没有变化时是否也发通知，填 true 或 false\n注：脚本默认 scriptTimeoutMs=8000，模块 timeout=10；远程脚本每小时检查一次更新。脚本固定引用 tag v3.6，升级时把三处 /v3.6/ 改成新 tag 即可"

[Script]
Tailscale 底层切换 = type=event, event-name=network-changed, script-path=https://raw.githubusercontent.com/lisongyan7050/sgmodule/v3.6/tailscale-underlying.js, timeout=10, script-update-interval=3600, argument="group={{{GROUP}}}&directSSID={{{DIRECT_SSID}}}&cellularSSID={{{CELLULAR_SSID}}}&debounceMs={{{DEBOUNCE_MS}}}&notifyOnNoop={{{NOTIFY_NOOP}}}"
Tailscale 底层启动 = type=event, event-name=engine-started, script-path=https://raw.githubusercontent.com/lisongyan7050/sgmodule/v3.6/tailscale-underlying.js, timeout=10, script-update-interval=3600, argument="group={{{GROUP}}}&directSSID={{{DIRECT_SSID}}}&cellularSSID={{{CELLULAR_SSID}}}&debounceMs={{{DEBOUNCE_MS}}}&notifyOnNoop={{{NOTIFY_NOOP}}}"
Tailscale 底层面板 = type=generic, script-path=https://raw.githubusercontent.com/lisongyan7050/sgmodule/v3.6/tailscale-underlying.js, timeout=10, script-update-interval=3600, argument="mode=panel&group={{{GROUP}}}"

[Panel]
Tailscale 底层 = title="Tailscale 底层", content="读取中…", script-name=Tailscale 底层面板, update-interval=300
